{
  "auth_mode": "profiles",
  "default_profiles": {
    "ssh": [
      "lab_local",
      "network_radius"
    ],
    "pyez": [
      "lab_local",
      "network_radius"
    ],
    "gnmic": [
      "gnmic_local"
    ]
  },
  "profiles": {
