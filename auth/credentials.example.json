    "network_radius": {
      "type": "username_password",
      "authentication_backend": "radius",
      "username": "CHANGE_ME",
      "password": "CHANGE_ME",
      "description": "Credentials validated by the device through RADIUS/AAA"
    },
    "gnmic_local": {
      "type": "username_password",
      "authentication_backend": "local",
      "username": "CHANGE_ME",
      "password": "CHANGE_ME",
      "description": "Local credentials used by gNMIc"
    }
  }
}
